getwd()
renv::install()
options(repos = c(CRAN = "https://cloud.r-project.org"))
# Verify it's reachable right now
available.packages()["future", "Version"]
# Should print something like "1.76.0"
file.remove("renv.lock")
unlink("renv/library", recursive = TRUE)   # old project library (may not exist)
unlink("renv/staging", recursive = TRUE)   # partial installs
install.packages(
c("shiny", "DT", "dplyr", "future", "promises", "lubridate",
"testthat", "shinytest2", "profvis", "usethis"),
repos = "https://cloud.r-project.org",
lib   = renv::paths$library()
)
# 1. What does renv think the repos are?
renv::config$repos.override()
# If this returns a non-NULL value, it WINS over everything else. Clear it:
# 2. Project-level renv settings
file.exists("renv/settings.json")
readLines("renv/settings.json")   # or file.show() it
# 1. What does renv think the repos are?
renv::config$repos.override()
# If this returns a non-NULL value, it WINS over everything else. Clear it:
# 2. Project-level renv settings
file.exists("renv/settings.json")
readLines("renv/settings.json")   # or file.show() it
# 3. Is Posit PM baked into renv's global config?
renv::config$user.profile()
# And check:
file.exists(tools::R_user_dir("renv", "config"))
# 4. The activation script's environment
Sys.getenv("RENV_CONFIG_REPOS_OVERRIDE")
Sys.getenv("RENV_REPOSITORIES")
# In R, project open:
renv::settings$ppm.enabled(FALSE)
readLines("renv/settings.json")
# You should now see: "ppm.enabled": false,
renv::settings$repos(c(CRAN = "https://cloud.r-project.org"))
options(repos = c(CRAN = "https://cloud.r-project.org"))
getOption("repos")
# Should print: CRAN https://cloud.r-project.org
renv::snapshot(force = T, prompt = T)
readLines("renv.lock")[1:15]
available.packages()["future", "Version"]
base::install.packages(
c("shiny", "DT", "dplyr", "future", "promises", "lubridate",
"testthat", "shinytest2", "profvis", "usethis"),
repos = "https://cloud.r-project.org",
lib   = renv::paths$library()
)
utils::install.packages(
c("shiny", "DT", "dplyr", "future", "promises", "lubridate",
"testthat", "shinytest2", "profvis", "usethis"),
repos = "https://cloud.r-project.org",
lib   = renv::paths$library()
)
renv::snapshot(prompt = F)
renv::status()
shiny::runApp()
shiny::runApp()
shiny::runApp()
